# Copy to .env and adjust as needed. The .env file is gitignored.
# docker-compose.yml reads these; all have sane defaults, so .env is optional
# for local development.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=cauce
POSTGRES_PASSWORD=cauce_dev
POSTGRES_DB=cauce_dev
POSTGRES_PORT=5433

# --- Redis / Adminer host ports (docker-compose) ---
REDIS_PORT=6379
ADMINER_PORT=8081

# --- Compose project name ---
# Containers and volumes are named after the clone's directory. Set this only to tell apart
# two clones that live in directories of the same name.
# COMPOSE_PROJECT_NAME=cauce

# --- Quickstart (docker compose --profile quickstart | --profile api), see QUICKSTART.md ---
# Which provider the quickstart scripts give the demo agent: ollama (default, local, no cost)
# or anthropic.
# QUICKSTART_PROVIDER=ollama
# Anthropic: compose passes this key to the app (the provider registers only when it is set).
# A secret: .env is gitignored, never commit it.
# ANTHROPIC_API_KEY=<secret>
# ANTHROPIC_MODEL=claude-haiku-5-5
# Model pulled into the Ollama container. Must support tool calling for the
# get_current_time demo; see QUICKSTART.md before changing it.
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_PORT=11434
# Your own Ollama instead of the containerized one (run with --profile api):
# OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
# The context length Ollama serves, read by both the ollama container and the app, which sizes
# its requests to it. With your own Ollama, set it to the value that Ollama is started with.
# OLLAMA_CONTEXT_LENGTH=4096
# Voice notes (ADR 0012): a local Whisper with --profile transcription, used when enabled.
# TRANSCRIPTION_ENABLED=true
# Another OpenAI-compatible transcription server instead of the containerized one:
# TRANSCRIPTION_BASE_URL=http://host.docker.internal:8000/v1
# TRANSCRIPTION_MODEL=Systran/faster-whisper-small
# The language the notes are in (ISO 639-1); empty, Whisper detects it.
# TRANSCRIPTION_LANGUAGE=es
# WHISPER_PORT=8000
# Host port for the containerized app. Change it if you also run bootRun
# (both default to 8080).
# API_PORT=8080

# --- Observability profile (docker compose --profile observability) ---
# OpenObserve's first user. The password needs 8+ characters with upper, lower, digit and symbol
# (OpenObserve refuses to start otherwise); change it before exposing the port.
# OPENOBSERVE_ROOT_EMAIL=root@cauce.local
# OPENOBSERVE_ROOT_PASSWORD=<secret>
# OPENOBSERVE_PORT=5080
# OPENOBSERVE_RETENTION_DAYS=30

# --- Spring Boot "prod" profile (application-prod.properties) ---
# Not used by docker-compose. Set these in the deployment environment.
# DATABASE_URL=jdbc:postgresql://<host>:5432/cauce
# DATABASE_USERNAME=cauce
# DATABASE_PASSWORD=<secret>
# REDIS_HOST=<host>
# REDIS_PORT=6379
# REDIS_PASSWORD=<secret>
