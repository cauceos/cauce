# Copy to .env and adjust as needed. The .env file is gitignored.
# docker-compose.yml reads these; all have sane defaults, so .env is optional
# for local development.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=cauce
POSTGRES_PASSWORD=cauce_dev
POSTGRES_DB=cauce_dev
POSTGRES_PORT=5433

# --- Redis / Adminer host ports (docker-compose) ---
REDIS_PORT=6379
ADMINER_PORT=8081

# --- Quickstart profile (docker compose --profile quickstart) ---
# Model pulled into the Ollama container. Must support tool calling for the
# get_current_time demo; see QUICKSTART.md before changing it.
# OLLAMA_MODEL=qwen2.5:3b
# OLLAMA_PORT=11434
# Host port for the containerized app. Change it if you also run bootRun
# (both default to 8080).
# API_PORT=8080

# --- Spring Boot "prod" profile (application-prod.properties) ---
# Not used by docker-compose. Set these in the deployment environment.
# DATABASE_URL=jdbc:postgresql://<host>:5432/cauce
# DATABASE_USERNAME=cauce
# DATABASE_PASSWORD=<secret>
# REDIS_HOST=<host>
# REDIS_PORT=6379
# REDIS_PASSWORD=<secret>
