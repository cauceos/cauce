# Copy to docker-compose.override.yml for local-only tweaks.
# Docker Compose merges it automatically on top of docker-compose.yml.
# The real override file is gitignored; this template is tracked.
#
# Examples below are commented out. Uncomment and edit what you need.

# services:
#   postgres:
#     # Pin the image by digest for reproducible builds.
#     # image: pgvector/pgvector:pg16@sha256:<digest>
#     ports:
#       # Use a different host port if 5433 is taken.
#       - "55432:5432"
#
#   redis:
#     ports:
#       - "16379:6379"
#
#   adminer:
#     ports:
#       - "18081:8080"
#
#   # The quickstart with your own Ollama (e.g. Apple Silicon, where the containerized one
#   # cannot use the GPU) needs no override: OLLAMA_BASE_URL in .env and --profile api,
#   # see QUICKSTART.md.

